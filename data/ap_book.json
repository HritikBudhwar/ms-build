  "history_decisions": {
    "INV-0901": {
      "by": "Ravi Kumar",
      "role": "AP Executive",
      "decision": "APPROVED",
      "note": "Clean three-way match. Paid on terms."
    },
    "INV-0902": {
      "by": "Meera Iyer",
      "role": "Head of Procurement",
      "decision": "APPROVED",
      "note": "Rate contract RC-SBP-2025 clause 7.2 gives Shree Balaji an annual escalation linked to the kraft paper index, capped at 2.5%, effective 1 April. Our PO master was never updated. Accept SBP price variance up to 2.5% without escalating to me. Anything above 2.5% comes to me."
    },
    "INV-0903": {
      "by": "Arjun Rao",
      "role": "Logistics Manager",
      "decision": "APPROVED",
      "note": "Diesel-linked fuel surcharge is allowed under transport agreement TA-CFC-24, Annexure B, up to 8% of base freight. It is never on the PO. Up to 8% is fine; above 8% push back."
    },
    "INV-0904": {
      "by": "Kavya Menon",
      "role": "Financial Controller",
      "decision": "PARTIAL",
      "note": "Deccan Steel files GSTR-1 late - usually between the 20th and 25th, not by the 11th - so their invoices miss our first GSTR-2B. Do not block a key steel supplier: release the taxable value, hold only the GST component until the invoice shows in 2B. It reflected in the next cycle."
    },
    "INV-0905A": {
      "by": "Ravi Kumar",
      "role": "AP Executive",
      "decision": "REJECTED",
      "note": "Cable rate billed 3.4% above PO. Sent back to Sri Lakshmi Electricals for correction."
    },
    "INV-0905": {
      "by": "Ravi Kumar",
      "role": "AP Executive",
      "decision": "APPROVED",
      "note": "Sri Lakshmi Electricals re-sends corrected invoices with a '-R' suffix. SLE/1187-R replaces SLE/1187, which they cancelled with credit note CN/SLE/044. Not a duplicate - pay the -R version and make sure the original is never paid. MSME (Small): keep within 45 days."
    },
    "INV-0906": {
      "by": "Arjun Rao",
      "role": "Logistics Manager",
      "decision": "REJECTED",
      "note": "Fuel surcharge of 11.2% is over the 8% Annexure B cap. I emailed Coastal citing Annexure B and they re-issued at 7.5% within two days. Pushback works with Coastal - always cite Annexure B."
    },
    "INV-0907": {
      "by": "Kavya Menon",
      "role": "Financial Controller",
      "decision": "APPROVED",
      "note": "Nimbus Cloudworks marks 194C on its invoices, but our tax consultant (opinion dated 9 Oct 2026) classified their ERP implementation and managed services as fees for technical services: deduct TDS under 194J(b) at 2%, not 194C. The rate is the same but the section matters for 26Q filing and their 26AS match. Update vendor master to 194J(b)."
